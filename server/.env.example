# Server Port
PORT=5000
NODE_ENV=development

# Published n8n Cloud Webhook Endpoints
N8N_BASE_URL=https://sonujangid105.app.n8n.cloud
N8N_ANALYSIS_WEBHOOK_URL=https://sonujangid105.app.n8n.cloud/webhook/returns-agent
N8N_FOLLOWUP_WEBHOOK_URL=https://sonujangid105.app.n8n.cloud/webhook/returnshield-ask
N8N_FEEDBACK_WEBHOOK_URL=https://sonujangid105.app.n8n.cloud/webhook/returnshield-feedback
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# Optional Direct Gemini Key (For standalone local LLM enrichment)
GEMINI_API_KEY=your_gemini_api_key_here
