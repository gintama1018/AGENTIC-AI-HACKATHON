# Server Port
PORT=5000
NODE_ENV=development

# Published n8n Webhook Endpoints
N8N_BASE_URL=http://localhost:5678
N8N_ANALYSIS_WEBHOOK_URL=http://localhost:5678/webhook/returns-agent
N8N_FOLLOWUP_WEBHOOK_URL=http://localhost:5678/webhook/returnshield-ask
N8N_FEEDBACK_WEBHOOK_URL=http://localhost:5678/webhook/returnshield-feedback
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# Fallback Gemini API Key (Optional local fallback only)
GEMINI_API_KEY=your_gemini_api_key_here
